# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=pureskin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pureskin

# --- Backend ---
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg2://pureskin:change-me@localhost:5432/pureskin

# JWT signing. Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
